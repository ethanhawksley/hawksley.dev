---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Misc from '../components/Misc.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, any>;
  robots?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  twitterCard?: 'summary' | 'summary_large_image';
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    readingTime: number;
  };
  preloadImage?: string;
  preloadType?: string;
}

const defaultOgImage = new URL('/og/home.jpg', Astro.site);

const {
  title,
  description,
  jsonLd,
  robots = 'max-image-preview:large',
  ogType = 'website',
  ogImage = defaultOgImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  twitterCard = 'summary_large_image',
  article,
  preloadImage,
  preloadType,
} = Astro.props;

const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '');

const isHome = cleanPath === '/';

const canonicalUrl = new URL(cleanPath, Astro.site).toString();

const isIndexable = !robots.includes('noindex');
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          as="image"
          type={preloadType}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      href="/fonts/ibm-sans-subset.woff2"
      as="font"
      type="font/woff2"
      fetchpriority={preloadImage ? undefined : 'high'}
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-mono-subset.woff2"
      as="font"
      type="font/woff2"
      fetchpriority={preloadImage ? undefined : 'high'}
      crossorigin
    />

    <title>{title}</title>

    <meta name="theme-color" content="#ff4f00" media="not all" />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f0f0f"
      media="(prefers-color-scheme: dark)"
    />

    <script is:inline>
      window.__getTheme = () => {
        const current = document.documentElement.getAttribute('data-theme');
        if (current === 'dark' || current === 'light') return current;

        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') return stored;
        } catch {}

        return matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      };

      window.__setTheme = (theme, save = true, doc = document) => {
        doc.documentElement.setAttribute('data-theme', theme);

        const color = theme === 'dark' ? '#0f0f0f' : '#fafafa';
        doc.head.querySelectorAll('meta[name="theme-color"]').forEach((tag) => {
          tag.setAttribute('content', color);
          tag.removeAttribute('media');
        });

        if (save) {
          setTimeout(() => {
            try {
              localStorage.setItem('theme', theme);
            } catch {}
          });
        }
      };

      window.__setTheme(window.__getTheme(), false);

      window.__themeTransition = document.startViewTransition
        ? document.startViewTransition.bind(document)
        : null;

      // Chromium has unbypassable flash of white on inter-page transitions.
      // Other engines don't have this problem.
      if (
        navigator.userAgentData &&
        navigator.userAgentData.brands &&
        navigator.userAgentData.brands.some((item) => item.brand === 'Chromium')
      ) {
        document.startViewTransition = undefined;
      }

      document.documentElement.classList.add('js');
    </script>

    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />

    {
      isIndexable && (
        <>
          <link rel="canonical" href={canonicalUrl} />

          <meta property="og:type" content={ogType} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:site_name" content="Ethan Hawksley" />
          <meta property="og:locale" content="en_GB" />
          <meta property="og:locale:alternate" content="en_US" />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:alt" content={title} />
          <meta property="og:image:width" content={ogImageWidth.toString()} />
          <meta property="og:image:height" content={ogImageHeight.toString()} />

          <meta name="twitter:card" content={twitterCard} />
          <meta name="twitter:site" content="@Ethan_Hawksley" />
          <meta name="twitter:creator" content="@Ethan_Hawksley" />

          {article && (
            <>
              <meta name="twitter:label1" content="Author" />
              <meta name="twitter:data1" content="Ethan Hawksley" />
              <meta name="twitter:label2" content="Reading time" />
              <meta
                name="twitter:data2"
                content={`${article.readingTime} min read`}
              />

              <meta
                property="article:published_time"
                content={article.publishedTime}
              />
              {article.modifiedTime && (
                <meta
                  property="article:modified_time"
                  content={article.modifiedTime}
                />
              )}
              <meta property="article:author" content="https://hawksley.dev/" />
            </>
          )}

          <meta name="author" content="Ethan Hawksley" />
          <meta
            name="fediverse:creator"
            content="@ethanhawksley@mastodon.social"
          />
        </>
      )
    }

    <link
      rel="alternate"
      href="/rss.xml"
      type="application/rss+xml"
      title="Ethan Hawksley's Blog"
    />
    <link
      rel="alternate"
      href="/feed.json"
      type="application/feed+json"
      title="Ethan Hawksley's Blog"
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      isHome && (
        <>
          <link rel="me" href="https://github.com/ethanhawksley" />
          <link rel="me" href="https://mastodon.social/@ethanhawksley" />
        </>
      )
    }

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
      <symbol
        id="icon-external"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"
        ></path>
        <path d="M11 13l9 -9"></path><path d="M15 4h5v5"></path>
      </symbol>
      <slot name="svg-symbols" />
    </svg>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="page">
      <div class="nav-bar">
        <Navigation />
      </div>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <div id="a11y-status-announce" class="sr-only" aria-live="polite"></div>

    <script>
      document.addEventListener('astro:before-swap', (event) => {
        window.__setTheme(window.__getTheme(), false, event.newDocument);
        event.newDocument.documentElement.classList.add('js');
      });
    </script>
    <Misc />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'IBM Sans Subset';
    font-style: normal;
    font-weight: 400 600;
    src: url('/fonts/ibm-sans-subset.woff2') format('woff2');
    font-display: swap;
  }

  @font-face {
    font-family: 'IBM Mono Subset';
    font-style: normal;
    font-weight: 400;
    src: url('/fonts/ibm-mono-subset.woff2') format('woff2');
    font-display: swap;
  }

  @property --accent-mix {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  :root {
    color-scheme: light dark;

    --color-background: #fafafa;
    --color-surface: #eaeaea;
    --color-text: #1a1a1a;
    --color-text-contrasted: #ffffff;
    --color-text-muted: #525252;
    --color-accent: #bf3900;
    --color-border: #e0e0e0;
    --color-border-control: #8c8c8c;
    --color-scrollbar-thumb: #b3b3b3;
    --color-selection: #bf3900;

    --font-size-xs: clamp(0.75rem, 0.7083rem + 0.2083vw, 0.875rem);
    --font-size-sm: clamp(0.875rem, 0.8333rem + 0.2083vw, 1rem);
    --font-size-base: clamp(1rem, 0.9583rem + 0.2083vw, 1.125rem);
    --font-size-md: clamp(1.1875rem, 1.1042rem + 0.4167vw, 1.4375rem);
    --font-size-lg: clamp(1.375rem, 1.25rem + 0.625vw, 1.75rem);
    --font-size-xl: clamp(1.625rem, 1.4167rem + 1.0417vw, 2.25rem);
    --font-size-2xl: clamp(2rem, 1.6667rem + 1.6667vw, 3rem);

    --leading-tight: 1.15;
    --leading-snug: 1.25;
    --leading-normal: 1.5;
    --leading-relaxed: 1.6;

    --tracking-tight: -0.025em;
    --tracking-snug: -0.015em;
    --tracking-normal: -0.01em;

    --weight-normal: 400;
    --weight-medium: 500;
    --weight-semibold: 600;

    --font-sans: 'IBM Sans Subset', sans-serif;
    --font-mono: 'IBM Mono Subset', monospace;

    --page-padding-x: clamp(6px, 3.2vw, 1.5rem);

    --img-theme-filter: none;
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;

    --color-background: #0f0f0f;
    --color-surface: #1f1f1f;
    --color-text: #ededed;
    --color-text-contrasted: #0f0f0f;
    --color-text-muted: #b0b0b0;
    --color-accent: #ff4f00;
    --color-border: #2a2a2a;
    --color-border-control: #6b6b6b;
    --color-scrollbar-thumb: #4d4d4d;
    --color-selection: #b33800;

    --img-theme-filter: brightness(0.85) contrast(1.1);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;

      --color-background: #0f0f0f;
      --color-surface: #1f1f1f;
      --color-text: #ededed;
      --color-text-contrasted: #0f0f0f;
      --color-text-muted: #b0b0b0;
      --color-accent: #ff4f00;
      --color-border: #2a2a2a;
      --color-border-control: #6b6b6b;
      --color-scrollbar-thumb: #4d4d4d;
      --color-selection: #b33800;

      --img-theme-filter: brightness(0.85) contrast(1.1);
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  html {
    scrollbar-gutter: stable;
    font-family: var(--font-sans);
    color: var(--color-text);
    accent-color: var(--color-accent);
    scrollbar-color: var(--color-scrollbar-thumb) var(--color-background);
    background-color: var(--color-background);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  @media (pointer: coarse) {
    html {
      scrollbar-gutter: auto;
    }
  }

  body {
    overflow-x: clip;
    font-size: var(--font-size-base);
    font-weight: var(--weight-normal);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    text-wrap: balance;
    scroll-margin-top: var(--font-size-md);
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  h2 {
    font-size: var(--font-size-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  h3 {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  h4 {
    font-size: var(--font-size-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  h5,
  h6 {
    font-size: var(--font-size-base);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  img,
  picture,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  img {
    filter: var(--img-theme-filter);
  }

  img:hover,
  img:focus {
    filter: none;
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  a svg,
  button svg {
    pointer-events: none;
  }

  button {
    padding: 0;
    font: inherit;
    cursor: pointer;
    background-color: transparent;
    border: 0;
    transition:
      --accent-mix 150ms ease-out,
      transform 100ms ease-out;
  }

  button:active {
    transform: scale(0.96);
  }

  ul[role='list'],
  ol[role='list'] {
    padding: 0;
    list-style: none;
  }

  small {
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
  }

  address {
    font-style: normal;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  main:focus-visible {
    outline: none;
  }

  ::selection {
    color: #fff;
    background-color: var(--color-selection);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    -webkit-user-select: none;
    user-select: none;
    border: 0;
    clip-path: inset(50%);
  }

  html[data-theme-transition='active']::view-transition-old(root),
  html[data-theme-transition='active']::view-transition-new(root) {
    mix-blend-mode: normal;
    animation-duration: 300ms;
    animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  html[data-theme-transition='active']::view-transition-old(root) {
    z-index: 1;
    animation: none;
  }

  html[data-theme-transition='active']::view-transition-new(root) {
    z-index: 2;
    animation-name: theme-crossfade-in;
  }

  @keyframes theme-crossfade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0s !important;
      animation-duration: 0s !important;
      animation-iteration-count: 1 !important;
    }

    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

  @media print {
    :root {
      color-scheme: light !important;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      break-after: avoid;
    }

    img {
      filter: none !important;
    }

    .nav-bar,
    .skip-link {
      display: none !important;
    }
  }
</style>

<style>
  .page {
    display: flex;
    flex-direction: column;
    max-width: 48rem;
    min-height: 100dvh;
    padding-top: max(1rem, env(safe-area-inset-top));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    margin-right: auto;
    margin-left: auto;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: max(1rem, env(safe-area-inset-left));
    z-index: 9999;
    padding: 0.5rem 1rem;
    color: var(--color-text-contrasted);
    text-decoration: none;
    background: var(--color-accent);
    border-radius: 0.25rem;
  }

  .skip-link:focus {
    top: max(1rem, env(safe-area-inset-top));
  }

  .nav-bar {
    margin-bottom: 1.5rem;
  }

  main {
    flex-grow: 1;
    padding-right: max(var(--page-padding-x), env(safe-area-inset-right));
    padding-left: max(var(--page-padding-x), env(safe-area-inset-left));
    margin-bottom: 1.5rem;
    scroll-margin-top: 1.5rem;
  }
</style>
