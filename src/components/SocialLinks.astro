---
import Email from '../assets/email.svg';
import Github from '../assets/github.svg';
import Linkedin from '../assets/linkedin.svg';
import A from './A.astro';
---

<address>
  <ul role="list">
    <li>
      <A
        class="email-address"
        href="mailto:ethan-REMOVE-THIS@hawksley.REMOVE-THIS.dev"
        rel="me"
        pressable
        data-nosnippet
      >
        <Email class="social-icon" aria-hidden="true" />
        ethan<span class="bait">-REMOVE-THIS</span>@<wbr />hawksley<span
          class="bait">.REMOVE-THIS</span
        >.dev</A
      >
    </li>
    <li>
      <A
        class="github-profile"
        href="https://github.com/ethanhawksley"
        rel="me noopener"
        pressable
      >
        <Github class="social-icon" aria-hidden="true" />
        GitHub</A
      >
    </li>
    <li>
      <A
        class="linkedin-profile"
        href="https://www.linkedin.com/in/ethanhawksley"
        rel="me noopener"
        pressable
      >
        <Linkedin class="social-icon" aria-hidden="true" />
        LinkedIn</A
      >
    </li>
  </ul>
</address>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  li {
    display: flex;
  }

  li > :global(a) {
    position: relative;
    flex-grow: 1;
    padding: 0.75rem 0.5rem 0.75rem 2.25rem;
  }

  .social-icon {
    position: absolute;
    top: 50%;
    left: 0.3rem;
    width: 1.5em;
    height: 1.5em;
    transform: translateY(-50%);
  }

  .bait {
    display: none;
    -webkit-user-select: none;
    user-select: none;
  }

  @media (min-width: 46.25em) {
    ul {
      flex-direction: row;
      gap: 0;
    }

    .email-address {
      min-width: 14rem;
    }

    .github-profile {
      min-width: 7.6rem;
    }

    .linkedin-profile {
      min-width: 8.2rem;
    }
  }
</style>

<script>
  const user = 'ZXRoYW4=';
  const domain = 'aGF3a3NsZXkuZGV2';
  const mailto = `mailto:${atob(user)}@${atob(domain)}`;

  document
    .querySelectorAll<HTMLAnchorElement>('.email-address')
    .forEach((link) => {
      const controller = new AbortController();

      const fixEmail = () => {
        link.href = mailto;
        controller.abort();
      };

      for (const event of ['mouseover', 'touchstart', 'focus', 'click']) {
        link.addEventListener(event, fixEmail, { signal: controller.signal });
      }
    });
</script>
