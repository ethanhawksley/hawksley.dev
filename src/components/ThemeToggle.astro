---
import Moon from '../assets/moon.svg';
import Sun from '../assets/sun.svg';
---

<button type="button" id="theme-toggle" aria-label="Switch to dark theme">
  <Moon class="moon" aria-hidden="true" />
  <Sun class="sun" aria-hidden="true" />
</button>

<style>
  button {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
  }

  :global(.js) button {
    display: flex;
  }

  .sun,
  .moon {
    position: absolute;
    width: 2rem;
    height: 2rem;
    color: var(--color-text);
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;
  }

  .sun {
    opacity: 0;
  }

  :global([data-theme='dark']) .moon {
    opacity: 0;
  }

  :global([data-theme='dark']) .sun {
    opacity: 1;
  }

  @media (hover: hover) {
    button:hover > .sun,
    button:hover > .moon {
      color: var(--color-accent);
    }
  }
</style>

<script>
  const mediaQuery = matchMedia('(prefers-color-scheme: dark)');

  function initThemeToggle() {
    const button = document.getElementById('theme-toggle')!;

    const updateAria = (theme: 'light' | 'dark') => {
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    };

    updateAria(window.__getTheme());

    const toggleTheme = () => {
      if (document.documentElement.dataset.themeTransition) return;

      const currentTheme = window.__getTheme();
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

      const prefersReducedMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (!window.__themeTransition || prefersReducedMotion) {
        window.__setTheme(nextTheme, true);
        updateAria(nextTheme);
        return;
      }

      document.documentElement.dataset.themeTransition = 'active';

      const transition = window.__themeTransition(() => {
        window.__setTheme(nextTheme, true);
        updateAria(nextTheme);
      });

      transition.finished.finally(() => {
        delete document.documentElement.dataset.themeTransition;
      });
    };

    button.addEventListener('click', toggleTheme);

    const controller = new AbortController();

    window.addEventListener(
      'storage',
      (e) => {
        if (e.key === 'theme') {
          const isDark =
            e.newValue === 'dark' ||
            (e.newValue === null && mediaQuery.matches);
          const theme = isDark ? 'dark' : 'light';

          window.__setTheme(theme, false);
          updateAria(theme);
        }
      },
      { signal: controller.signal },
    );

    mediaQuery.addEventListener(
      'change',
      (e) => {
        try {
          if (localStorage.getItem('theme') !== null) return;
        } catch {}

        const theme = e.matches ? 'dark' : 'light';
        window.__setTheme(theme, false);
        updateAria(theme);
      },
      { signal: controller.signal },
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        delete document.documentElement.dataset.themeTransition;
        controller.abort();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
