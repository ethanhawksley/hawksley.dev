---
import Moon from '../assets/moon.svg';
import Sun from '../assets/sun.svg';
---

<button type="button" id="theme-toggle" aria-label="Switch to dark theme">
  <Moon class="moon" aria-hidden="true" />
  <Sun class="sun" aria-hidden="true" />
</button>

<style>
  button {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
  }

  :global(.js) button {
    display: flex;
  }

  .sun,
  .moon {
    position: absolute;
    width: 2rem;
    height: 2rem;
    color: var(--color-text);
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;
  }

  .sun {
    opacity: 0;
  }

  :global([data-theme='dark']) .moon {
    opacity: 0;
  }

  :global([data-theme='dark']) .sun {
    opacity: 1;
  }

  @media (hover: hover) {
    button:hover > .sun,
    button:hover > .moon,
    button[data-hover] > .sun,
    button[data-hover] > .moon {
      color: var(--color-accent);
    }
  }
</style>

<script>
  const mediaQuery = matchMedia('(prefers-color-scheme: dark)');

  function initThemeToggle() {
    const button = document.getElementById('theme-toggle')!;

    let activeTransition: ViewTransition | null = null;
    let transitionController: AbortController | null = null;
    let isReady = false;
    let startTheme: 'light' | 'dark' = 'light';
    let targetTheme: 'light' | 'dark' = 'dark';
    let intendedTheme: 'light' | 'dark' = 'dark';

    const updateAria = (theme: 'light' | 'dark') => {
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    };

    const cleanupTransition = () => {
      transitionController?.abort();
      transitionController = null;
      activeTransition = null;
      isReady = false;
      document.documentElement.style.removeProperty('cursor');
      delete button.dataset.hover;
      delete document.documentElement.dataset.themeTransition;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          delete document.documentElement.dataset.noTransitions;
        }),
      );
    };

    updateAria(window.__getTheme());

    const isInsideButton = (clientX: number, clientY: number) => {
      const rect = button.getBoundingClientRect();
      return (
        clientX >= rect.left &&
        clientX <= rect.right &&
        clientY >= rect.top &&
        clientY <= rect.bottom
      );
    };

    const getViewTransitionAnimations = () => {
      return document.getAnimations().filter((anim) => {
        const effect = anim.effect;
        return (
          effect &&
          'pseudoElement' in effect &&
          effect.pseudoElement === '::view-transition-new(root)'
        );
      });
    };

    const toggleTheme = () => {
      const currentTheme = window.__getTheme();

      if (activeTransition) {
        if (!isReady) {
          activeTransition.skipTransition();
          window.__setTheme(startTheme, true);
          updateAria(startTheme);
          cleanupTransition();
          return;
        }

        const anims = getViewTransitionAnimations();
        if (anims.length === 0) {
          activeTransition.skipTransition();
          window.__setTheme(startTheme, true);
          updateAria(startTheme);
          cleanupTransition();
          return;
        }

        intendedTheme =
          intendedTheme === targetTheme ? startTheme : targetTheme;
        updateAria(intendedTheme);

        anims.forEach((anim) => {
          try {
            anim.reverse();
          } catch {}
        });
        return;
      }

      startTheme = currentTheme;
      targetTheme = currentTheme === 'dark' ? 'light' : 'dark';
      intendedTheme = targetTheme;

      const prefersReducedMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (!window.__themeTransition || prefersReducedMotion) {
        window.__setTheme(targetTheme, true);
        updateAria(targetTheme);
        return;
      }

      const isHovered = button.matches(':hover');
      document.documentElement.dataset.themeTransition = 'active';
      document.documentElement.dataset.noTransitions = 'true';

      transitionController = new AbortController();
      const { signal } = transitionController;

      if (isHovered) {
        document.documentElement.style.setProperty('cursor', 'pointer');
        button.dataset.hover = '';

        const checkCursorBounds = (clientX: number, clientY: number) => {
          if (isInsideButton(clientX, clientY)) {
            document.documentElement.style.setProperty('cursor', 'pointer');
            button.dataset.hover = '';
          } else {
            document.documentElement.style.removeProperty('cursor');
            delete button.dataset.hover;
          }
        };

        window.addEventListener(
          'pointermove',
          (e) => checkCursorBounds(e.clientX, e.clientY),
          { signal, passive: true },
        );
      }

      window.addEventListener(
        'pointerdown',
        (e: PointerEvent) => {
          if (e.button !== 0) return;
          if (isInsideButton(e.clientX, e.clientY)) {
            e.preventDefault();
            e.stopImmediatePropagation();
            toggleTheme();
          }
        },
        { signal, capture: true },
      );

      isReady = false;

      const transition = window.__themeTransition(() => {
        window.__setTheme(targetTheme, true);
        updateAria(targetTheme);
      });

      activeTransition = transition;

      transition.ready
        .then(() => {
          if (activeTransition === transition) {
            isReady = true;

            const anims = getViewTransitionAnimations();
            if (anims.length > 0) {
              anims[0].finished
                .catch(() => {})
                .then(() => {
                  if (activeTransition === transition) {
                    if (intendedTheme === startTheme) {
                      window.__setTheme(startTheme, true);
                      activeTransition.skipTransition();
                    }
                  }
                });
            }
          }
        })
        .catch(() => {});

      transition.finished
        .catch(() => {})
        .finally(() => {
          if (activeTransition === transition) {
            cleanupTransition();
          }
        });
    };

    button.addEventListener('click', toggleTheme);

    const controller = new AbortController();

    window.addEventListener(
      'storage',
      (e) => {
        if (e.key === 'theme') {
          const theme = window.__getTheme();
          window.__setTheme(theme, false);
          updateAria(theme);
        }
      },
      { signal: controller.signal },
    );

    mediaQuery.addEventListener(
      'change',
      () => {
        try {
          if (localStorage.getItem('theme') !== null) return;
        } catch {}

        const theme = window.__getTheme();
        window.__setTheme(theme, false);
        updateAria(theme);
      },
      { signal: controller.signal },
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        activeTransition?.skipTransition();
        cleanupTransition();
        controller.abort();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
