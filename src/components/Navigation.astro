---
import LogoRounded from '../assets/hawksley-dev-logo-rounded.svg';
import ThemeToggle from './ThemeToggle.astro';

const cleanPath =
  Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';

const isHome = cleanPath === '/';
const isBlog = cleanPath.startsWith('/blog');
---

<header>
  <nav aria-label="Main">
    <a href="/" aria-label="Home" class="logo"
      ><LogoRounded width="3rem" height="3rem" aria-hidden="true" /></a
    >
    <div class="page-links">
      <a
        href="/"
        class:list={[{ active: isHome }]}
        aria-current={isHome ? 'page' : undefined}
      >
        Home</a
      >
      {' '}
      <a
        href="/blog"
        class:list={[{ active: isBlog }]}
        aria-current={isBlog ? 'page' : undefined}
      >
        Blog</a
      >
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding-right: max(var(--page-padding-x), env(safe-area-inset-right));
    padding-left: max(var(--page-padding-x), env(safe-area-inset-left));
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .logo {
    width: 3rem;
    height: 3rem;
  }

  .page-links {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
  }

  .page-links a {
    padding-right: 0.5rem;
    padding-left: 0.5rem;
    margin-right: -0.5rem;
    margin-left: -0.5rem;
    color: var(--color-text);
    transition:
      color 150ms ease-out,
      transform 100ms ease-out;
  }

  .page-links a:hover {
    color: var(--color-accent);
  }

  .page-links a:active {
    transform: scale(0.96);
  }

  .page-links .active {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    color: var(--color-accent);
  }
</style>
