---
import type { HTMLAttributes } from 'astro/types';

const protocols = new Set(['http:', 'https:']);
const internalHostnames = new Set([
  'hawksley.dev',
  '127.0.0.1',
  'localhost',
  '0.0.0.0',
]);

interface Props extends HTMLAttributes<'a'> {
  href: string;
  pressable?: boolean;
  external?: boolean;
}
const { href, pressable, external, ...rest } = Astro.props;

function isExternal(linkHref: string): boolean {
  if (/^(?:[#/.]|\/(?!\/))/i.test(linkHref)) {
    return false;
  }

  try {
    const url = new URL(linkHref, Astro.url);

    if (!protocols.has(url.protocol)) return false;

    if (url.hostname === Astro.url.hostname) return false;

    if (internalHostnames.has(url.hostname)) return false;

    if (Astro.site && url.hostname === Astro.site.hostname) return false;

    return true;
  } catch {
    return false;
  }
}

const isExternalLink = external ?? isExternal(href);
---

<a
  href={href}
  target={isExternalLink ? '_blank' : undefined}
  data-pressable={pressable || undefined}
  {...rest}
  ><span
    ><slot />{
      isExternalLink && <span class="sr-only"> (opens in a new tab)</span>
    }</span
  >{
    isExternalLink && (
      <svg width="14" height="14" aria-hidden="true">
        <use href="#icon-external" />
      </svg>
    )
  }
</a>

<style>
  a {
    color: var(--color-text);
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  a:hover {
    color: var(--color-accent);
  }

  a[data-pressable] {
    display: inline-block;
    transition:
      color 150ms ease-out,
      transform 100ms ease-out;
  }

  a[data-pressable]:active {
    transform: scale(0.96);
  }

  a > span {
    white-space: normal;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  a > svg {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.05em;
    vertical-align: -0.2em;
  }

  @media print {
    a svg {
      display: none !important;
    }
  }
</style>
