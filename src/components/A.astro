---
import type { HTMLAttributes } from 'astro/types';

const protocols = new Set(['http:', 'https:']);
const internalHostnames = new Set(['hawksley.dev', '127.0.0.1', 'localhost']);

interface Props extends HTMLAttributes<'a'> {
  href: string;
  pressable?: boolean;
  external?: boolean;
}
const { href, rel, style, pressable, external, ...rest } = Astro.props;

function isExternal(linkHref: string) {
  const url = new URL(linkHref, Astro.url);

  // Treat unknown protocols as internal
  if (!protocols.has(url.protocol)) return false;

  return !internalHostnames.has(url.hostname);
}

const isExternalLink = external ?? isExternal(href);
---

<a
  href={href}
  target={isExternalLink ? '_blank' : undefined}
  rel={rel || (isExternalLink ? 'noopener noreferrer' : undefined)}
  style={style}
  data-pressable={pressable || undefined}
  {...rest}
  ><span
    ><slot />{
      isExternalLink && <span class="sr-only"> (opens in a new tab)</span>
    }</span
  >{
    isExternalLink && (
      <svg width="14" height="14" aria-hidden="true">
        <use href="#icon-external" />
      </svg>
    )
  }
</a>

<style>
  a {
    color: var(--color-text);
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  a:hover {
    color: var(--color-accent);
  }

  a[data-pressable] {
    display: inline-block;
    transition:
      color 150ms ease-out,
      transform 100ms ease-out;
  }

  a[data-pressable]:active {
    transform: scale(0.96);
  }

  a > span {
    white-space: normal;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  a > svg {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.05em;
    vertical-align: -0.2em;
  }

  @media print {
    a svg {
      display: none !important;
    }
  }
</style>
