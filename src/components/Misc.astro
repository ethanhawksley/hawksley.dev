<script>
  // @ts-nocheck
  console.log('Welcome to the console! :)');

  let pageHistory = [window.location.href];
  let hasChosen = false;

  document.addEventListener('astro:after-swap', () => {
    if (pageHistory.length > 0) {
      if (
        pageHistory.length >= 2 &&
        pageHistory[pageHistory.length - 2] !== window.location.href
      ) {
        pageHistory = [window.location.href];
      } else {
        pageHistory.push(window.location.href);
      }

      if (pageHistory.length === 16) {
        pageHistory = [];
        console.log('* (Well, there is a man here.)');
        console.log('* (He offered you something.)');
        console.log('yes   no');

        function setupResponse(option, reply) {
          Object.defineProperty(window, option, {
            get() {
              if (hasChosen) {
                console.log('* (Well, there is not a man here.)');
              } else {
                console.log(reply);
                hasChosen = true;
              }
            },
            configurable: true,
          });
        }
        setupResponse('yes', '* (You received an Easter Egg.)');
        setupResponse('no', "* (Then he needn't be here.)");
      }
    }
  });

  const ENDPOINT = 'https://g.hawksley.dev/count';

  function isBot() {
    const w = window;
    const d = document;
    const n = navigator;

    if (w.callPhantom || w._phantom || w.phantom) return 150;
    if (w.__nightmare) return 151;
    if (d.__selenium_unwrapped || d.__webdriver_evaluate || d.__driver_evaluate)
      return 152;
    if (n.webdriver) return 153;
    if (
      w.screen.width === 0 ||
      w.screen.height === 0 ||
      (w.outerWidth === 0 && w.outerHeight === 0)
    )
      return 154;

    return 0;
  }

  function filterCount() {
    const bot = isBot();
    if (bot) return `bot (${bot})`;
    if (location !== parent.location) return 'frame';
    if (
      location.hostname.match(
        /(localhost$|^127\.|^10\.|^172\.(1[6-9]|2[0-9]|3[0-1])\.|^192\.168\.|^0\.0\.0\.0$)/,
      )
    ) {
      return 'localhost';
    }
    if (location.protocol === 'file:') return 'localfile';
    return false;
  }

  function count(vars = {}) {
    const filtered = filterCount();
    if (filtered) {
      if (console?.warn)
        console.warn('goatcounter: not counting because of: ' + filtered);
      return;
    }

    let path = vars.path ?? location.pathname + location.search;
    let referrer = vars.referrer ?? document.referrer;
    let title = vars.title ?? document.title;

    const data = {
      p: path,
      r: referrer,
      t: title,
      s: window.screen.width,
      q: location.search,
      rnd: Math.random().toString(36).slice(2, 7),
    };

    const url = ENDPOINT + '?' + new URLSearchParams(data).toString();

    if (!navigator.sendBeacon(url)) {
      const img = document.createElement('img');
      img.src = url;
      img.style.display = 'none';
      img.setAttribute('alt', '');
      img.setAttribute('aria-hidden', 'true');
      document.body.appendChild(img);
    }
  }

  let isFirstLoad = true;
  let previousUrl = document.referrer;

  document.addEventListener('astro:before-swap', () => {
    previousUrl = window.location.href;
  });

  function executeCount() {
    count({
      path: location.pathname + location.search,
      referrer: previousUrl,
    });
  }

  function setupFirstLoadTracking() {
    if (document.prerendering) {
      document.addEventListener(
        'prerenderingchange',
        () => setupFirstLoadTracking(),
        { once: true },
      );
      return;
    }

    let counted = false;
    let visibleStartTime =
      document.visibilityState === 'visible' ? Date.now() : 0;
    let dwellTimer = null;

    const trigger = (e) => {
      if (e && !e.isTrusted) return;
      if (counted) return;
      counted = true;

      cleanup();
      executeCount();
    };

    const events = ['pointerdown', 'scroll', 'wheel', 'keydown', 'touchstart'];

    let initialX = null,
      initialY = null;
    const onMouseMove = (e) => {
      if (!e.isTrusted) return;
      if (initialX === null) {
        initialX = e.clientX;
        initialY = e.clientY;
        return;
      }
      if (
        Math.abs(e.clientX - initialX) > 2 ||
        Math.abs(e.clientY - initialY) > 2
      ) {
        trigger(e);
      }
    };

    const cleanup = () => {
      events.forEach((ev) => window.removeEventListener(ev, trigger));
      window.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('pagehide', onExit);
      if (dwellTimer) clearTimeout(dwellTimer);
    };

    const scheduleDwellTimer = () => {
      if (dwellTimer) clearTimeout(dwellTimer);
      if (document.visibilityState === 'visible') {
        if (!visibleStartTime) visibleStartTime = Date.now();
        dwellTimer = setTimeout(() => {
          if (document.visibilityState === 'visible') trigger();
        }, 2000);
      }
    };

    const onExit = () => {
      if (counted) return;
      if (visibleStartTime && Date.now() - visibleStartTime > 1000) {
        trigger();
      }
    };

    const onVisibilityChange = () => {
      if (document.visibilityState === 'visible') {
        scheduleDwellTimer();
      } else {
        onExit();
      }
    };

    events.forEach((ev) =>
      window.addEventListener(ev, trigger, { once: true, passive: true }),
    );
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('pagehide', onExit, { once: true });

    scheduleDwellTimer();
  }

  document.addEventListener('astro:page-load', () => {
    if (!isFirstLoad) {
      executeCount();
      return;
    }
    isFirstLoad = false;
    setupFirstLoadTracking();
  });
</script>
