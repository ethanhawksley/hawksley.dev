<script>
  console.log('Welcome to the console! :)');

  function initEasterEgg() {
    try {
      const historyJson = sessionStorage.getItem('pageHistory');
      let pageHistory = historyJson ? JSON.parse(historyJson) : [];
      let hasChosen = false;

      if (
        pageHistory.length >= 2 &&
        pageHistory[pageHistory.length - 2] !== window.location.href
      ) {
        pageHistory = [window.location.href];
      } else {
        pageHistory.push(window.location.href);
      }

      if (pageHistory.length === 16) {
        sessionStorage.removeItem('pageHistory');
        console.log('* (Well, there is a man here.)');
        console.log('* (He offered you something.)');
        console.log('yes   no');

        const setupResponse = (option: 'yes' | 'no', reply: string) => {
          Object.defineProperty(window, option, {
            get() {
              if (hasChosen) {
                console.log('* (Well, there is not a man here.)');
              } else {
                console.log(reply);
                hasChosen = true;
              }
            },
            configurable: true,
          });
        };

        setupResponse('yes', '* (You received an Easter Egg.)');
        setupResponse('no', "* (Then he needn't be here.)");
      } else {
        sessionStorage.setItem('pageHistory', JSON.stringify(pageHistory));
      }
    } catch {}
  }

  const prefetched = new Set<string>();

  function getUrl(a: HTMLAnchorElement) {
    return a.href.split('#')[0];
  }

  function shouldPrefetch(a: HTMLAnchorElement) {
    if (
      !a.href ||
      a.origin !== location.origin ||
      (a.target && a.target !== '_self') ||
      a.closest('[data-no-prefetch]') ||
      (a.pathname === location.pathname && a.search === location.search)
    ) {
      return false;
    }

    return !prefetched.has(getUrl(a));
  }

  function prefetch(a: HTMLAnchorElement) {
    const url = getUrl(a);
    if (prefetched.has(url)) return;
    prefetched.add(url);

    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.href = url;
    document.head.appendChild(link);
  }

  function initPrefetch() {
    if (HTMLScriptElement.supports?.('speculationrules')) {
      return;
    }

    if (navigator?.connection?.saveData) return;

    document.addEventListener(
      'pointerdown',
      (e: PointerEvent) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)
          return;
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a');
        if (a && shouldPrefetch(a)) prefetch(a);
      },
      { passive: true },
    );

    let hoverTimer: ReturnType<typeof setTimeout> | null = null;
    let activeAnchor: HTMLAnchorElement | null = null;

    function clearTimer() {
      if (hoverTimer !== null) {
        clearTimeout(hoverTimer);
        hoverTimer = null;
      }
      activeAnchor = null;
    }

    document.addEventListener(
      'pointerover',
      (e: PointerEvent) => {
        if (e.pointerType === 'touch') return;
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a');

        if (!a || a === activeAnchor || !shouldPrefetch(a)) return;

        clearTimer();
        activeAnchor = a;

        hoverTimer = setTimeout(() => {
          prefetch(a);
          clearTimer();
        }, 80);
      },
      { passive: true },
    );

    document.addEventListener(
      'pointerout',
      (e: PointerEvent) => {
        if (e.pointerType === 'touch' || !activeAnchor) return;

        const related = e.relatedTarget as Node | null;
        if (related && activeAnchor.contains(related)) return;

        clearTimer();
      },
      { passive: true },
    );
  }

  interface CountOptions {
    path?: string;
    referrer?: string;
    title?: string;
  }

  function isBot() {
    return (
      navigator.webdriver ||
      window.screen.width === 0 ||
      window.screen.height === 0
    );
  }

  function filterCount() {
    const bot = isBot();
    if (bot) return 'bot';
    if (window.location !== window.parent.location) return 'frame';
    if (
      /^(localhost$|127\.|10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.|0\.0\.0\.0$)/.test(
        window.location.hostname,
      )
    ) {
      return 'localhost';
    }
    if (window.location.protocol === 'file:') return 'localfile';
    return false;
  }

  function count(vars: CountOptions = {}) {
    const filtered = filterCount();
    if (filtered) {
      if (console.warn) {
        console.warn(`goatcounter: not counting because of: ${filtered}`);
      }
      return;
    }

    const path = vars.path ?? window.location.pathname + window.location.search;
    const referrer = vars.referrer ?? document.referrer;
    const title = vars.title ?? document.title;

    const data = {
      p: path,
      r: referrer,
      t: title,
      s: window.screen.width.toString(),
      q: window.location.search,
      rnd: Math.random().toString(36).slice(2, 7),
    };

    const url = `https://g.hawksley.dev/count?${new URLSearchParams(data).toString()}`;

    if (!navigator.sendBeacon || !navigator.sendBeacon(url)) {
      const img = document.createElement('img');
      img.src = url;
      img.style.display = 'none';
      img.alt = '';
      img.setAttribute('aria-hidden', 'true');
      document.body.appendChild(img);
    }
  }

  function setupTracking() {
    let counted = false;

    const executeCount = () => {
      count({
        path: window.location.pathname + window.location.search,
        referrer: document.referrer,
      });
    };

    const cleanup = () => {
      events.forEach((ev) => window.removeEventListener(ev, trigger));
      window.removeEventListener('mousemove', onMouseMove);
    };

    const trigger = (e?: Event) => {
      if (e && !e.isTrusted) return;
      if (counted) return;
      counted = true;

      cleanup();
      executeCount();
    };

    const events = [
      'pointerdown',
      'scroll',
      'wheel',
      'keydown',
      'touchstart',
    ] as const;

    let initialX: number | null = null;
    let initialY: number | null = null;

    const onMouseMove = (e: MouseEvent) => {
      if (!e.isTrusted) return;
      if (initialX === null || initialY === null) {
        initialX = e.clientX;
        initialY = e.clientY;
        return;
      }
      if (
        Math.abs(e.clientX - initialX) > 2 ||
        Math.abs(e.clientY - initialY) > 2
      ) {
        trigger(e);
      }
    };

    events.forEach((ev) =>
      window.addEventListener(ev, trigger, { once: true, passive: true }),
    );
    window.addEventListener('mousemove', onMouseMove, { passive: true });
  }

  function init() {
    initEasterEgg();
    initPrefetch();
    setupTracking();
  }

  if (document.prerendering) {
    document.addEventListener('prerenderingchange', init, { once: true });
  } else {
    init();
  }
</script>
