---
const FORM_ID = '9595926';
const action = `https://app.kit.com/forms/${FORM_ID}/subscriptions`;

type Props = {
  heading: string;
  subtext: string;
};

const { heading, subtext } = Astro.props;
---

<section aria-labelledby="newsletter-heading">
  <header>
    <h2 id="newsletter-heading">{heading}</h2>
    <p>{subtext}</p>
  </header>

  <form action={action} method="post" data-kit-form>
    <label for="newsletter-signup-email" class="sr-only">Email address</label>
    <input
      id="newsletter-signup-email"
      type="email"
      name="email_address"
      placeholder="you@example.com"
      required
      autocomplete="email"
    />
    <button type="submit">Subscribe</button>
  </form>

  <footer aria-live="polite">
    <span class="newsletter-success" tabindex="-1" hidden>
      Thanks, now just check your inbox to confirm!
    </span>
    <span class="newsletter-error" tabindex="-1" hidden>
      Something went wrong. Please try again.
    </span>
  </footer>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 65ch;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  h2 {
    font-size: var(--font-size-base);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  p {
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }

  input {
    flex: 1;
    min-width: min(100%, 200px);
    padding: 0.35rem 0.25rem 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--leading-snug);
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--color-border-control);
    border-radius: 0;
    transition: border-bottom-color 150ms ease-out;
  }

  input:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }

  button {
    padding-top: 0.35rem;
    padding-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-text);
    color: color-mix(
      in oklch,
      var(--color-accent) var(--accent-mix),
      var(--color-text)
    );
    border-bottom: 2px solid var(--color-accent);
  }

  button:hover {
    --accent-mix: 100%;
  }

  button:active {
    transform: scale(0.96);
  }

  footer {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .newsletter-error {
    color: var(--color-accent);
  }

  span:focus {
    outline: none;
  }

  form[hidden] {
    display: none;
  }

  button[aria-disabled='true'] {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-border);
    cursor: not-allowed;
  }

  @media print {
    section {
      display: none !important;
    }
  }
</style>

<script>
  function initNewsletter() {
    const controller = new AbortController();

    document.addEventListener(
      'submit',
      async (event: SubmitEvent) => {
        const form = (event.target as HTMLElement).closest<HTMLFormElement>(
          '[data-kit-form]',
        );
        if (!form) return;

        event.preventDefault();

        const container = form.closest('section');
        if (!container) return;

        const success = container.querySelector<HTMLElement>(
          '.newsletter-success',
        );
        const error = container.querySelector<HTMLElement>('.newsletter-error');
        const button = form.querySelector('button');

        if (!button || !success || !error) return;
        if (button.getAttribute('aria-disabled') === 'true') return;

        button.setAttribute('aria-disabled', 'true');
        const originalText = button.textContent;
        button.textContent = 'Subscribing…';
        error.hidden = true;

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (!res.ok) throw new Error();

          form.hidden = true;
          success.hidden = false;
          success.focus();
        } catch {
          error.hidden = false;
          button.removeAttribute('aria-disabled');
          button.textContent = originalText;
          error.focus();
        }
      },
      { signal: controller.signal },
    );

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
    });
  }

  document.addEventListener('astro:page-load', initNewsletter);
</script>
