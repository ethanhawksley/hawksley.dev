---
import A from './A.astro';

interface ProjectLink {
  name: string;
  url: string;
}

interface Props {
  name: string;
  description: string;
  url: string;
  links?: ProjectLink[];
  type: 'Web' | 'CLI' | 'Book';
  stack: string[];
}

const { name, description, links = [], url, type, stack } = Astro.props;
---

<li>
  <article>
    <h3>
      {
        (
          <A href={url} pressable>
            {name}
          </A>
        )
      }
    </h3>
    <p>{description}</p>
    <footer>
      <div class="meta">
        <span class="type">{type}</span>
        {
          stack.length > 0 && (
            <>
              <span aria-hidden="true">/</span>
              <span class="sr-only">Stack: </span>
              <span>{stack.join(', ')}</span>
            </>
          )
        }
      </div>
      {
        links.length > 0 && (
          <div class="meta-actions">
            {links.map((link) => (
              <A href={link.url} pressable>
                <span class="sr-only">View {name} </span>
                {link.name}
              </A>
            ))}
          </div>
        )
      }
    </footer>
  </article>
</li>

<style>
  li + li {
    border-top: 1px solid var(--color-border);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  p {
    max-width: 65ch;
    color: var(--color-text-muted);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    color: var(--color-text-muted);
  }

  .type {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .meta-action :global(a) {
    font-weight: var(--weight-medium);
  }
</style>
