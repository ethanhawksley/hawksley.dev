---
import A from './A.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  readingTime: number;
  headingLevel: 'h2' | 'h3';
}
const { href, title, description, pubDate, readingTime, headingLevel } =
  Astro.props;
const Heading = headingLevel;
---

<li>
  <article>
    <Heading><A href={href} pressable>{title}</A></Heading>
    <p>{description}</p>
    <footer>
      <span class="post-date">
        <FormattedDate date={pubDate} />
      </span>
      <span aria-hidden="true">·</span>
      <time class="read-time" datetime=`PT${readingTime}M`
        >{readingTime} min read</time
      >
    </footer>
  </article>
</li>

<style>
  li + li {
    border-top: 1px solid var(--color-border);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  h2 {
    font-size: var(--font-size-lg);
  }

  p {
    max-width: 65ch;
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .post-date {
    white-space: nowrap;
  }

  .read-time {
    white-space: nowrap;
  }
</style>
