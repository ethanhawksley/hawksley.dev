---
import A from './A.astro';

const year = new Date().getFullYear();
---

<footer>
  <small>
    <span class="group">
      <span>&copy; {year} Ethan Hawksley</span>
      <span aria-hidden="true" class="dot">·</span>
      <A href="https://github.com/ethanhawksley/hawksley.dev" pressable
        >Source</A
      >
    </span>
    <span aria-hidden="true" class="dot mid-dot">·</span>
    <span class="group">
      <A href="/rss.xml" pressable data-astro-prefetch="false">RSS</A>
      <span aria-hidden="true" class="dot">·</span>
      <A href="/key.asc" pressable data-astro-prefetch="false">PGP</A>
      <span aria-hidden="true" class="dot">·</span>
      <A href="/elsewhere" pressable>Elsewhere</A>
    </span>
  </small>
</footer>

<style>
  footer {
    padding-right: max(var(--page-padding-x), env(safe-area-inset-right));
    padding-left: max(var(--page-padding-x), env(safe-area-inset-left));
    text-align: center;
  }

  small {
    display: inline-flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 0.5em;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .group {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: center;
    justify-content: center;
  }

  .mid-dot {
    display: none;
  }

  @media (min-width: 30em) {
    small {
      flex-direction: row;
      gap: 0.4em;
    }

    .mid-dot {
      display: inline;
    }
  }
</style>
