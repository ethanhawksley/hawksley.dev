---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import A from '../../components/A.astro';
import { personJsonLd, websiteRef } from '../../utils/jsonLd';
import { getSortedSecondMaintainer } from '../../utils/content-helpers';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const allChapters = await getSortedSecondMaintainer();
const firstChapter = allChapters[0];

// Inline low quality avif since book index fits into initcwd
// On Cloudflare, initcwd is ~40KB.
const inlineImagePath = path.join(
  process.cwd(),
  'src/assets/the-second-maintainer-400x640.avif',
);
const inlineImageBuffer = fs.readFileSync(inlineImagePath);
const inlineImageBase64 = `data:image/avif;base64,${inlineImageBuffer.toString('base64')}`;

const ogImageUrl =
  'https://hawksley.dev/the-second-maintainer/the-second-maintainer.jpg';

const pageUrl = 'https://hawksley.dev/the-second-maintainer';
const coverImageUrl =
  'https://hawksley.dev/the-second-maintainer/the-second-maintainer.jpg';

const description =
  'A non-fiction book on the XZ Utils backdoor: open-source social engineering, Linux supply chain attacks, and how 500 milliseconds saved the internet.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteRef,
    {
      '@type': 'ItemPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      name: 'The Second Maintainer | Ethan Hawksley',
      description,
      inLanguage: 'en',
      mainEntity: { '@id': `${pageUrl}#book` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: coverImageUrl,
        name: 'The Second Maintainer Cover',
        width: 1600,
        height: 2560,
      },
    },
    {
      '@type': 'Book',
      '@id': `${pageUrl}#book`,
      url: pageUrl,
      name: 'The Second Maintainer',
      description,
      inLanguage: 'en',
      datePublished: '2026-09-02',
      copyrightYear: 2026,
      about: {
        '@type': 'Thing',
        name: 'XZ Utils backdoor',
        sameAs: 'https://www.wikidata.org/wiki/Q125219704',
      },
      author: { '@id': 'https://hawksley.dev#person' },
      publisher: { '@id': 'https://hawksley.dev#person' },
      license: 'https://creativecommons.org/licenses/by-sa/4.0/',
      isAccessibleForFree: true,
      image: coverImageUrl,
      workExample: [
        {
          '@type': 'Book',
          '@id': `${pageUrl}#ebook`,
          isbn: '9781291547375',
          bookEdition: 'Ebook',
          bookFormat: 'https://schema.org/EBook',
          inLanguage: 'en',
          datePublished: '2026-09-02',
        },
        {
          '@type': 'Book',
          '@id': `${pageUrl}#paperback`,
          isbn: '9780557908899',
          bookEdition: 'Paperback',
          bookFormat: 'https://schema.org/Paperback',
          inLanguage: 'en',
          datePublished: '2026-09-02',
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          item: 'https://hawksley.dev',
          position: 1,
          name: 'Home',
        },
        {
          '@type': 'ListItem',
          item: pageUrl,
          position: 2,
          name: 'The Second Maintainer',
        },
      ],
    },
  ],
};
---

<Layout
  title="The Second Maintainer: XZ Utils Backdoor Book | Ethan Hawksley"
  description={description}
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
  ogImageWidth={1600}
  ogImageHeight={2560}
  twitterCard="summary"
>
  <section class="hero">
    <div class="hero-content">
      <h1>The Second Maintainer</h1>
      <p class="subtitle">Inside the XZ Utils Backdoor, by Ethan Hawksley</p>
      <p class="blurb">
        <em>The Second Maintainer</em> is a non-fiction book that tells the true story
        of the XZ Utils backdoor. It exposes the social engineering performed against
        open-source maintainers, the supply chain attack that threatened the very
        backbone of the internet, and how just 500 milliseconds saved us all.
      </p>
      <A
        class="read-link"
        href={`/the-second-maintainer/${firstChapter.id}`}
        pressable
      >
        Read Online<span class="arrow" aria-hidden="true">→</span>
      </A>
      <div
        class="action-matrix"
        aria-label="Book formats, downloads, and retailers"
      >
        <div class="action-row">
          <span class="action-category">Free Download:</span>
          <div class="action-links">
            <A
              href="/the-second-maintainer/the-second-maintainer.pdf"
              download
              pressable
              data-astro-prefetch="false"
            >
              PDF
            </A>
            <span aria-hidden="true" class="dot">·</span>
            <A
              href="/the-second-maintainer/the-second-maintainer.epub"
              download
              pressable
              data-astro-prefetch="false"
            >
              EPUB
            </A>
          </div>
        </div>
        <div class="action-row">
          <span class="action-category">Print Edition:</span>
          <div class="action-links">
            <!--<A href="https://example.com" pressable>Amazon</A>-->
            <!--<span aria-hidden="true" class="dot">·</span>-->
            <!--<A href="https://example.com" pressable>Waterstones</A>-->
            <!--<span aria-hidden="true" class="dot">·</span>-->
            <A
              href="https://www.lulu.com/shop/ethan-hawksley/the-second-maintainer/paperback/product-zmvmje8.html"
              pressable>Lulu<span class="sr-only"> (Paperback edition)</span></A
            >
            <span aria-hidden="true" class="dot">·</span>
            <span>Other retailers coming soon</span>
          </div>
        </div>
        <div class="action-row">
          <span class="action-category">Ebook Stores:</span>
          <div class="action-links">
            <A
              href="https://www.lulu.com/shop/ethan-hawksley/the-second-maintainer/ebook/product-kv48jrz.html"
              pressable
            >
              Lulu<span class="sr-only"> (Ebook edition)</span></A
            >
            <span aria-hidden="true" class="dot">·</span>
            <span>Other retailers coming soon</span>
            <!--<A href="https://example.com" pressable>Kindle</A>-->
            <!--<span aria-hidden="true" class="dot">·</span>-->
            <!--<A href="https://example.com" pressable>Kobo</A>-->
            <!--<span aria-hidden="true" class="dot">·</span>-->
            <!--<A href="https://example.com" pressable>Apple Books</A>-->
          </div>
        </div>
        <div class="action-row">
          <span class="action-category">Open License:</span>
          <div class="action-links">
            <A href="https://creativecommons.org/licenses/by-sa/4.0/" pressable>
              CC BY-SA 4.0
            </A>
          </div>
        </div>
      </div>
    </div>
    <picture>
      <source
        srcset="/the-second-maintainer/the-second-maintainer.avif"
        type="image/avif"
      />
      <img
        class="book-cover"
        src="/the-second-maintainer/the-second-maintainer.jpg"
        alt="The Second Maintainer: Inside the XZ Utils Backdoor book cover"
        width="200"
        height="320"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        style={`background-image:url(${inlineImageBase64})`}
      />
    </picture>
  </section>
  <section class="about-the-book" aria-labelledby="about-the-book-heading">
    <h2 id="about-the-book-heading">About the Book</h2>
    <p>
      For over a decade, the development of XZ Utils had fallen to just one man:
      Lasse Collin. Whilst he maintained it quietly in the background, burnout
      began to set in. The thousands of hours spent on this project were
      starting to catch up to him.
    </p>
    <p>
      When all hope seemed lost, a new face arrived. Jia Tan offered help, and
      with this, Lasse's luck began to shift...
    </p>
  </section>
  <section class="toc" aria-labelledby="toc-heading">
    <h2 id="toc-heading">Table of Contents</h2>
    <ol class="toc-list" role="list">
      {
        allChapters.map((chapter) => (
          <li>
            <A href={`/the-second-maintainer/${chapter.id}`} pressable>
              {chapter.data.index}: {chapter.data.title}
            </A>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="newsletter-wrapper">
    <NewsletterSignup
      heading="Get new writing in your inbox"
      subtext="Only sent when I publish something cool :)"
    />
  </div>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .hero-content {
    min-width: 0;
  }

  .subtitle {
    margin-top: -1rem;
    margin-bottom: 0.25rem;
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .blurb {
    max-width: 50ch;
    line-height: var(--leading-normal);
    text-wrap: balance;
  }

  .read-link {
    margin-bottom: 1.5rem;
  }

  .arrow {
    display: inline-block;
    margin-left: 0.25em;
    transition: transform 250ms ease-out;
  }

  :global(a:hover) .arrow {
    transform: translateX(0.25em);
  }

  .book-cover {
    width: 160px;
    height: 256px;
    font-size: 0;
    -webkit-user-select: none;
    user-select: none;
    object-fit: cover;
    background-color: #191919;
    background-position: center;
    background-size: cover;
    border: 2px solid var(--color-border);
    filter: none !important;
  }

  @media (min-width: 45em) {
    .hero {
      flex-direction: row;
      gap: 0;
      justify-content: space-between;
    }

    .hero picture {
      flex-shrink: 0;
    }

    .book-cover {
      width: 200px;
      height: 320px;
    }
  }

  .action-matrix {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .action-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 32em) {
    .action-row {
      flex-direction: row;
      gap: 0.75rem;
      align-items: baseline;
    }

    .action-category {
      width: 14ch;
    }
  }

  .action-category {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .action-links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: center;
  }

  .dot {
    color: var(--color-text-muted);
  }

  .about-the-book {
    margin-bottom: 2rem;
  }

  .about-the-book p + p {
    margin-top: 1.5rem;
  }

  .toc-list li {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    font-weight: var(--weight-medium);
  }

  .toc-list li + li {
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin-bottom: 1rem;
  }

  p {
    line-height: var(--leading-normal);
  }

  .newsletter-wrapper {
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }
</style>
