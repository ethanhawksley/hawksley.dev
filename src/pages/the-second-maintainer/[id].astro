---
import { render } from 'astro:content';

import Layout from '../../layouts/Layout.astro';
import A from '../../components/A.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

import { getSortedSecondMaintainer } from '../../utils/content-helpers';
import { personJsonLd, websiteJsonLd } from '../../utils/jsonLd';

import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allChapters = await getSortedSecondMaintainer();

  return allChapters.map((chapter, index) => ({
    params: { id: chapter.id },
    props: {
      chapter,
      prevChapter: allChapters[index - 1] ?? null,
      nextChapter: allChapters[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { chapter, prevChapter, nextChapter } = Astro.props;
const { Content } = await render(chapter);

const chapterUrl = `https://hawksley.dev/the-second-maintainer/${chapter.id}`;
const fullTitle = `${chapter.data.index}: ${chapter.data.title}`;

const ogImageUrl = new URL(
  `/og/the-second-maintainer/${chapter.id}.jpg`,
  Astro.site,
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteJsonLd,
    {
      '@type': 'WebPage',
      '@id': `${chapterUrl}#webpage`,
      url: chapterUrl,
      isPartOf: { '@id': 'https://hawksley.dev/#website' },
      name: `${fullTitle} | The Second Maintainer`,
      description: chapter.data.metaDescription,
      inLanguage: 'en',
      mainEntity: { '@id': `${chapterUrl}#chapter` },
      breadcrumb: { '@id': `${chapterUrl}#breadcrumb` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        name: `${fullTitle} - Cover Image`,
        width: 1200,
        height: 630,
      },
    },
    {
      '@type': 'Book',
      '@id': 'https://hawksley.dev/the-second-maintainer#book',
      url: 'https://hawksley.dev/the-second-maintainer',
      name: 'The Second Maintainer',
      author: { '@id': 'https://hawksley.dev/#person' },
      publisher: { '@id': 'https://hawksley.dev/#person' },
    },
    {
      '@type': 'Chapter',
      '@id': `${chapterUrl}#chapter`,
      url: chapterUrl,
      mainEntityOfPage: { '@id': `${chapterUrl}#webpage` },
      isPartOf: { '@id': 'https://hawksley.dev/the-second-maintainer#book' },
      name: chapter.data.title,
      headline: fullTitle,
      description: chapter.data.metaDescription,
      position: chapter.data.index,
      inLanguage: 'en',
      isAccessibleForFree: true,
      author: { '@id': 'https://hawksley.dev/#person' },
      publisher: { '@id': 'https://hawksley.dev/#person' },
      image: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 1200,
        height: 630,
      },
      license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${chapterUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          item: 'https://hawksley.dev/the-second-maintainer',
          position: 1,
          name: 'The Second Maintainer',
        },
        {
          '@type': 'ListItem',
          item: chapterUrl,
          position: 2,
          name: chapter.data.title,
        },
      ],
    },
  ],
};
---

<Layout
  title={`${fullTitle} | The Second Maintainer`}
  description={chapter.data.metaDescription}
  jsonLd={jsonLd}
  ogType="article"
  ogImage={ogImageUrl}
>
  <div class="back-to-index">
    <A href="/the-second-maintainer" pressable>
      <span class="arrow" aria-hidden="true">←</span> The Second Maintainer
    </A>
  </div>
  <article>
    <header>
      <h1>{fullTitle}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    !nextChapter && (
      <div class="newsletter-wrapper">
        <NewsletterSignup
          heading="Enjoyed the book?"
          subtext="Sign up to get an email only when I publish something cool :)"
        />
      </div>
    )
  }

  <nav class="chapter-pager" aria-label="Chapter pagination">
    <div class="pager-links">
      <div class="pager-prev">
        {
          prevChapter && (
            <a
              href={`/the-second-maintainer/${prevChapter.id}`}
              class="pager-link"
            >
              <span class="pager-link-label">
                <span class="arrow" aria-hidden="true">
                  ←
                </span>
                Previous
              </span>
              <span class="pager-link-title">
                {prevChapter.data.index}: {prevChapter.data.title}
              </span>
            </a>
          )
        }
      </div>
      <div class="pager-next">
        {
          nextChapter && (
            <a
              href={`/the-second-maintainer/${nextChapter.id}`}
              class="pager-link pager-link-next"
            >
              <span class="pager-link-label pager-link-label-next">
                Next
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="pager-link-title">
                {nextChapter.data.index}: {nextChapter.data.title}
              </span>
            </a>
          )
        }
      </div>
    </div>
    <div class="pager-view-all">
      <A href="/the-second-maintainer" pressable>Table of Contents</A>
    </div>
  </nav>
</Layout>

<style is:global>
  .prose {
    min-width: 0;
  }

  .prose > :first-child,
  .prose blockquote > :first-child {
    margin-top: 0;
  }

  .prose > :last-child,
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  .prose p,
  .prose li,
  .prose blockquote {
    max-width: 65ch;
  }

  .prose p {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose blockquote {
    padding: 1rem 1.5rem;
    font-style: italic;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    border-top-right-radius: 0.5rem;
    border-bottom-right-radius: 0.5rem;
  }

  .prose hr {
    max-width: 65ch;
    height: auto;
    margin: 2.5rem 0;
    overflow: visible;
    text-align: center;
    border: 0;
  }

  .prose hr::before {
    display: block;
    margin-right: -0.5em;
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    letter-spacing: 0.5em;
    content: '***';
  }

  @media print {
    .back-to-index,
    .chapter-pager {
      display: none !important;
    }
  }
</style>

<style>
  .arrow {
    display: inline-block;
    transition: transform 250ms ease-out;
  }

  .back-to-index {
    margin-bottom: 0.5rem;
    font-size: var(--font-size-sm);
  }

  .back-to-index :global(a) {
    color: color-mix(
      in oklch,
      var(--color-accent) var(--accent-mix),
      var(--color-text-muted)
    );
  }

  .back-to-index .arrow {
    margin-right: 0.15em;
  }

  .back-to-index :global(a:hover) .arrow {
    transform: translateX(-0.25em);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  header {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border);
  }

  .newsletter-wrapper {
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .chapter-pager {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pager-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--color-text);
    color: color-mix(
      in oklch,
      var(--color-accent) var(--accent-mix),
      var(--color-text)
    );
    text-decoration: none;
    transition: --accent-mix 150ms ease-out;
  }

  .pager-link:active {
    transform: scale(0.96);
  }

  .pager-link-label {
    display: flex;
    gap: 0.35em;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .pager-link-label-next {
    justify-content: flex-end;
  }

  .pager-link-title {
    font-weight: var(--weight-medium);
    text-wrap: balance;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  .pager-link-next .pager-link-title {
    text-align: right;
  }

  .pager-link:hover {
    --accent-mix: 100%;
  }

  .pager-prev .pager-link:hover .arrow {
    transform: translateX(-0.25em);
  }

  .pager-next .pager-link:hover .arrow {
    transform: translateX(0.25em);
  }

  .pager-view-all {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 40em) {
    .pager-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .pager-prev {
      grid-column: 1;
    }

    .pager-next {
      grid-column: 2;
    }
  }
</style>
