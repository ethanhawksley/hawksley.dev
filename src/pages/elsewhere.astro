---
import Layout from '../layouts/Layout.astro';
import A from '../components/A.astro';

import { personJsonLd, websiteJsonLd } from '../utils/jsonLd';
import { profileSections } from '../utils/profiles';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteJsonLd,
    {
      '@type': 'CollectionPage',
      '@id': 'https://hawksley.dev/elsewhere#webpage',
      url: 'https://hawksley.dev/elsewhere',
      isPartOf: { '@id': 'https://hawksley.dev/#website' },
      name: 'Elsewhere',
      description:
        'Online profiles of Ethan Hawksley, computer science student at the University of Warwick and author of The Second Maintainer.',
      inLanguage: 'en',
      about: { '@id': 'https://hawksley.dev/#person' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://hawksley.dev/ethan-hawksley.jpg',
        name: 'Ethan Hawksley',
        caption: 'Ethan Hawksley',
        width: 1536,
        height: 1536,
      },
    },
  ],
};

const ogImageUrl = new URL('/og/elsewhere.jpg', Astro.site).toString();
---

<Layout
  title="Elsewhere | Ethan Hawksley"
  description="Online profiles of Ethan Hawksley, computer science student at the University of Warwick and author of The Second Maintainer."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <h1>Elsewhere</h1>
  <p>You can find me on various other platforms around the web.</p>
  {
    profileSections.map((section) => {
      const slug = section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const id = `heading-${slug}`;
      // Internal links are used instead of external for profiles.
      // It reduces the visual clutter of arrows, whilst staying consistent UX.
      return (
        <section>
          <h2 id={id}>{section.title}</h2>
          <ul role="list">
            {section.links.map((link) => (
              <li>
                <span>
                  <A href={link.url} rel="me" external={false} pressable>
                    {link.name}
                  </A>
                </span>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</Layout>

<style>
  p {
    max-width: 65ch;
    margin-bottom: 1.5rem;
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  section {
    margin-bottom: 2rem;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: var(--font-size-lg);
  }

  li {
    display: flex;
    align-items: baseline;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  li + li {
    border-top: 1px solid var(--color-border);
  }

  span {
    font-weight: var(--weight-medium);
  }
</style>
