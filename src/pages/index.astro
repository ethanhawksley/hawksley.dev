---
import fs from 'node:fs';
import path from 'node:path';

import Layout from '../layouts/Layout.astro';
import A from '../components/A.astro';
import LatestPosts from '../components/LatestPosts.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import SocialLinks from '../components/SocialLinks.astro';

import { getSortedPosts, getSortedProjects } from '../utils/content-helpers';
import { personJsonLd, websiteJsonLd } from '../utils/jsonLd';

// Inline low quality avif since home page fits into initcwd
// On Cloudflare, initcwd is ~40KB.
const inlineImagePath = path.join(
  process.cwd(),
  'src/assets/ethan-hawksley-360.avif',
);
const inlineImageBuffer = fs.readFileSync(inlineImagePath);
const inlineImageBase64 = `data:image/avif;base64,${inlineImageBuffer.toString('base64')}`;

const ogImageUrl = new URL('/og/home.jpg', Astro.site).toString();

const allProjects = await getSortedProjects();

const allPosts = await getSortedPosts();
const lastModified = allPosts[0].data.pubDate.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteJsonLd,
    {
      '@type': 'ProfilePage',
      '@id': 'https://hawksley.dev/#webpage',
      url: 'https://hawksley.dev/',
      isPartOf: { '@id': 'https://hawksley.dev/#website' },
      name: 'About Ethan Hawksley',
      mainEntity: { '@id': 'https://hawksley.dev/#person' },
      dateCreated: '2024-09-10T00:00:00.000Z',
      dateModified: lastModified,
      primaryImageOfPage: 'https://hawksley.dev/ethan-hawksley.jpg',
    },
  ],
};
---

<Layout
  title="Ethan Hawksley"
  description="Ethan Hawksley is a computer science student at the University of Warwick and author of The Second Maintainer. Explore his projects and blog."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <section class="hero">
    <div class="hero-content">
      <h1>Ethan Hawksley</h1>
      <p class="hero-lead">
        Ethan Hawksley is a computer science student at the
        University&nbsp;of&nbsp;Warwick, focusing on systems‑level programming
        and cybersecurity. He is also the author of the book <A
          href="/the-second-maintainer">The&nbsp;Second&nbsp;Maintainer</A
        >. Outside of coding, I enjoy writing about what I make and where I
        visit.
      </p>
      <SocialLinks />
    </div>
    <picture>
      <source srcset="/ethan-hawksley.avif" type="image/avif" />
      <img
        class="hero-avatar"
        src="/ethan-hawksley.jpg"
        alt="Ethan Hawksley"
        width="180"
        height="180"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        style={`background-image:url(${inlineImageBase64})`}
      />
    </picture>
  </section>
  <section class="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul role="list">
      {
        allProjects.map((project) => (
          <ProjectPreview
            name={project.data.name}
            description={project.data.description}
            links={project.data.links}
            url={project.data.url}
            type={project.data.type}
            stack={project.data.stack}
          />
        ))
      }
    </ul>
  </section>
  <section aria-labelledby="blog-heading">
    <h2 id="blog-heading">Latest Posts</h2>
    <p>Articles primarily on tech, but also whatever grabs my attention.</p>
    <LatestPosts />
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .hero p {
    max-width: 30ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin-bottom: 1rem;
  }

  .hero-sub {
    width: fit-content;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .hero picture {
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 120px;
    height: 120px;
    font-size: 0;
    -webkit-user-select: none;
    user-select: none;
    object-fit: cover;
    background-color: #3e631f;
    background-position: center;
    background-size: cover;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    filter: none !important;
  }

  @media (min-width: 28em) {
    .hero p {
      max-width: 50ch;
    }
  }

  @media (min-width: 41em) {
    .hero {
      flex-direction: row;
      gap: 0;
      justify-content: space-between;
    }

    .hero-avatar {
      width: 180px;
      height: 180px;
    }
  }

  h2 {
    margin-bottom: 1rem;
  }

  p {
    line-height: var(--leading-normal);
  }

  .projects {
    margin-bottom: 2rem;
  }
</style>
