---
import Layout from '../../layouts/Layout.astro';
import PostPreview from '../../components/PostPreview.astro';
import { getSortedPosts } from '../../utils/content-helpers';
import { personJsonLd, websiteRef } from '../../utils/jsonLd';

const allPosts = await getSortedPosts();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personJsonLd,
    websiteRef,
    {
      '@type': 'CollectionPage',
      '@id': 'https://hawksley.dev/blog#webpage',
      url: 'https://hawksley.dev/blog',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      name: "Ethan Hawksley's Blog",
      description:
        'A blog by Ethan Hawksley, a Computer Science student in the UK. Articles on systems programming, cybersecurity, and whatever else grabs my attention.',
      inLanguage: 'en',
      mainEntity: { '@id': 'https://hawksley.dev/blog#blog' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://hawksley.dev/ethan-hawksley.jpg',
        name: 'Ethan Hawksley',
        caption: 'Ethan Hawksley',
        width: 1536,
        height: 1536,
      },
    },
    {
      '@type': 'Blog',
      '@id': 'https://hawksley.dev/blog#blog',
      isPartOf: { '@id': 'https://hawksley.dev#website' },
      mainEntityOfPage: { '@id': 'https://hawksley.dev/blog#webpage' },
      name: "Ethan Hawksley's Blog",
      description:
        'A blog by Ethan Hawksley, a Computer Science student in the UK. Articles on systems programming, cybersecurity, and whatever else grabs my attention.',
      inLanguage: 'en',
      publisher: { '@id': 'https://hawksley.dev#person' },
      license: 'https://creativecommons.org/licenses/by/4.0/',
    },
  ],
};

const ogImageUrl = new URL('/og/blog.jpg', Astro.site).toString();
---

<Layout
  title="Blog | Ethan Hawksley"
  description="A blog by Ethan Hawksley, a Computer Science student in the UK. Posts on systems programming, cybersecurity, and whatever else grabs my attention."
  jsonLd={jsonLd}
  ogType="website"
  ogImage={ogImageUrl}
>
  <h1>Blog</h1>
  <p>Articles primarily on tech, but also whatever grabs my attention.</p>
  <ul role="list">
    {
      allPosts.map((post) => (
        <PostPreview
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          headingLevel="h2"
        />
      ))
    }
  </ul>
</Layout>
<style>
  p {
    max-width: 65ch;
    margin-bottom: 1.5rem;
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
</style>
